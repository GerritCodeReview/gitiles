{namespace com.google.gitiles.templates.PathDetail}

import * as common from 'com/google/gitiles/templates/Common.soy';
import * as objDetail from 'com/google/gitiles/templates/ObjectDetail.soy';

/**
 * Detail page for a path within a tree.
 */
{template pathDetail stricthtml="false"}
  {@param title: ?}  /** human-readable name of this path. */
  {@param repositoryName: ?}  /** name of this repository. */
  {@param? menuEntries: ?}  /** menu entries. */
  {@param? customVariant: ?}  /** variant name for custom styling. */
  {@param breadcrumbs: ?}  /** breadcrumbs for this page. */
  {@param type: ?}  /** path type, matching one of the constant names defined in
      org.eclipse.jgit.lib.FileMode. */
  {@param data: ?}  /** path data, matching the params for one of .treeDetail, .blobDetail,
      .symlinkDetail, or .gitlinkDetail as appropriate. */
  {@param? navigation: ?}  /** optional file navigation data, matching the params for
      .fileNavigation_. */
  {@param? containerClass: ?}  /** optional class to append to the main container. */
  {@inject staticUrls: ?}
{if $type == 'REGULAR_FILE' || $type == 'EXECUTABLE_FILE'}
  {call common.header data="all"}
    {param css: [$staticUrls.PRETTIFY_CSS_URL] /}
  {/call}
{elseif $data.readmeHtml}
  {call common.header data="all"}
    {param css: [$staticUrls.DOC_CSS_URL, $staticUrls.PRETTIFY_CSS_URL] /}
  {/call}
{else}
  {call common.header data="all" /}
{/if}

{if $navigation}
  <div class="PathDetail">
    {call fileNavigation_ data="$navigation" /}
    <div class="PathDetail-main">
      {call pathContent_ data="all" /}
    </div>
  </div>
{else}
  {call pathContent_ data="all" /}
{/if}

{call common.footer}
  {param customVariant: $customVariant /}
{/call}
{/template}

/**
 * Main content of a path page.
 */
{template pathContent_}
  {@param type: ?}  /** path type, as in .pathDetail. */
  {@param data: ?}  /** path data, as in .pathDetail. */
{switch $type}
  {case 'TREE'}
    {call objDetail.treeDetail data="$data" /}
  {case 'SYMLINK'}
    {call symlinkDetail data="$data" /}
  {case 'REGULAR_FILE'}
    {call objDetail.blobDetail data="$data" /}
  {case 'EXECUTABLE_FILE'}
    {call objDetail.blobDetail data="$data" /}
  {case 'GITLINK'}
    {call gitlinkDetail data="$data" /}
  {default}
    <div class="error">
      {msg desc="Error message for an unknown object type"}Object has unknown type.{/msg}
    </div>
{/switch}
{/template}

/**
 * Sidebar listing the root of the tree, expanded along the path to the current file.
 */
{template fileNavigation_}
  {@param entries: ?}  /** root entries, matching the params for .fileNavigationList_. */
  {@param? moreCount: ?}  /** number of root entries not listed. */
  {@param? moreUrl: ?}  /** URL of the root tree, listing all entries. */
<nav class="FileNav" aria-labelledby="FileNav-heading">
  <details class="FileNav-details" open>
    <summary class="FileNav-summary" id="FileNav-heading">
      {msg desc="Heading for the list of files next to a file"}Files{/msg}
    </summary>
    {call fileNavigationList_ data="all" /}
  </details>
</nav>
{/template}

/**
 * One directory level of the file navigation sidebar.
 */
{template fileNavigationList_}
  {@param entries: ?}  /** list of entries, each with type, name, url, and optionally current or
      children, the nested level for a directory on the current path. */
  {@param? moreCount: ?}  /** number of entries not listed. */
  {@param? moreUrl: ?}  /** URL of the tree page listing all entries. */
<ul class="FileNav-list">
  {for $entry in $entries}
    <li class="FileNav-item{sp}
        {switch $entry.type}
          {case 'TREE'}FileNav-item--gitTree
          {case 'SYMLINK'}FileNav-item--symlink
          {case 'REGULAR_FILE'}FileNav-item--regularFile
          {case 'EXECUTABLE_FILE'}FileNav-item--executableFile
          {case 'GITLINK'}FileNav-item--gitlink
          {default}FileNav-item--regularFile
        {/switch}">
      <a class="FileNav-link" href="{$entry.url}"
          {if $entry.current}aria-current="page"{/if}>
        {$entry.name}
      </a>
      {if $entry.children}
        {call fileNavigationList_ data="$entry.children" /}
      {/if}
    </li>
  {/for}
  {if $moreCount}
    <li class="FileNav-more">
      <a href="{$moreUrl}">
        {msg desc="Link to the full listing of a directory truncated in the sidebar"}
          {$moreCount} more...
        {/msg}
      </a>
    </li>
  {/if}
</ul>
{/template}

/**
 * Detail for a symbolic link.
 */
{template symlinkDetail}
  {@param target: ?}  /** target of this symlink. */
  {@param? targetUrl: ?}  /** optional URL for the target, if it is within this repo. */
<div class="symlink-detail">
  {msg desc="Lead-in text for the symbolic link target."}Symbolic link to{/msg}
  {sp}{if $targetUrl}<a href="{$targetUrl}">{$target}</a>{else}{$target}{/if}
</div>
{/template}

/**
 * Detail for a git submodule link.
 */
{template gitlinkDetail}
  {@param sha: ?}  /** submodule commit SHA. */
  {@param remoteUrl: ?}  /** URL of the remote repository. */
  {@param? httpUrl: ?}  /** optional HTTP URL pointing to a web-browser-compatible URL of the remote
      repository. */
<div class="gitlink-detail">
  {msg desc="Lead-in text for the git link URL"}Submodule link to {$sha} of{/msg}
  {if $remoteUrl}
    {sp}{if $httpUrl}<a href="{$httpUrl}">{$remoteUrl}</a>{else}{$remoteUrl}{/if}
  {else}
    {sp}{msg desc="Text describing an unknown submodule URL"}a submodule with an unknown URL{/msg}
  {/if}
</div>
{/template}
