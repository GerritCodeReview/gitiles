{namespace com.google.gitiles.templates.GrepDetail}

import * as common from 'com/google/gitiles/templates/Common.soy';

/**
 * Detail page for file-content search results.
 */
{template grepDetail stricthtml="false"}
  {@param title: ?}
  {@inject staticUrls: ?}
  {@param repositoryName: ?}
  {@param? menuEntries: ?}
  {@param? customVariant: ?}
  {@param breadcrumbs: ?}
  {@param revision: string}
  {@param path: string}
  {@param substring: string}
  {@param hasSearch: bool}
  {@param hasMore: bool}
  {@param timedOut: bool}
  {@param continueUrl: string}
  {@param jsonFormatUrl: string}
  {@param files: list<?>}  /** matching files, each with path, url and lines. */
  {@param matchCount: int}
  {@param fileCount: int}

{call common.header data="all"}
  {param css: [$staticUrls.PRETTIFY_CSS_URL] /}
{/call}

{let $placeholder kind="text"}
  {msg desc="placeholder and accessible label for the grep search box"}Search file contents{/msg}
{/let}
<form method="GET" class="GrepSearch">
  <input type="search" name="s" value="{$substring}" class="GrepSearch-input"
         placeholder="{$placeholder}" aria-label="{$placeholder}"
         required {if not $hasSearch}autofocus{/if}>
  <button type="submit" class="GrepSearch-button">
    {msg desc="button text for grep search"}Search{/msg}
  </button>
</form>

{if $path}
  <p class="GrepSearch-path">
    {msg desc="search path label"}Searching in{/msg}
    {sp}<span class="u-monospace">{$path}</span>
  </p>
{/if}

{if $hasSearch}
  {if length($files)}
    <p class="GrepResults-summary">
      {if $hasMore}
        {msg desc="prefix of the grep summary when more matches exist"}Showing{/msg}{sp}
      {/if}
      {msg desc="number of grep matches shown"}
        {plural $matchCount}{case 1}1 match{default}{$matchCount} matches{/plural}
      {/msg}
      {sp}
      {msg desc="number of files with grep matches shown"}
        {plural $fileCount}{case 1}in 1 file{default}in {$fileCount} files{/plural}
      {/msg}
    </p>
    <ol class="GrepResults">
      {for $file in $files}
        <li class="GrepResults-item">
          <a class="u-monospace GrepResults-file" href="{$file.url}">{$file.path}</a>
          {sp}<span class="GrepResults-count">({length($file.lines)})</span>
          <ol class="GrepResults-lines">
            {for $line in $file.lines}
              <li class="u-monospace GrepResults-line">
                <a class="GrepResults-lineNumber" href="{$line.url}">{$line.lineNumber}</a>
                {sp}<code>
                  {if $line.truncatedStart}&hellip;{/if}
                  {for $piece in $line.pieces}
                    {if $piece.match}
                      <mark class="GrepResults-match">
                        <span class="{$piece.classes}">{$piece.text}</span>
                      </mark>
                    {else}
                      <span class="{$piece.classes}">{$piece.text}</span>
                    {/if}
                  {/for}
                  {if $line.truncatedEnd}&hellip;{/if}
                </code>
              </li>
            {/for}
          </ol>
        </li>
      {/for}
    </ol>
  {elseif not $timedOut}
    <p class="GrepResults-empty">
      {msg desc="message shown when grep search has no matches"}No matches.{/msg}
    </p>
  {/if}
  {if $timedOut}
    <p class="GrepResults-more">
      {msg desc="message shown when grep search stops at its time limit"}Search stopped before finishing because it took too long. Narrow the search path to search fewer files.{/msg}
    </p>
  {elseif $hasMore}
    <p class="GrepResults-more">
      {msg desc="message shown when additional grep matches exist"}More matches exist. Narrow the search path to see more specific results.{/msg}
    </p>
  {/if}
  {if $continueUrl}
    <p class="GrepResults-continue">
      <a href="{$continueUrl}">{msg desc="link to continue a grep search where it stopped"}Continue search{/msg}</a>
    </p>
  {/if}
{/if}

{call common.footer}
  {param customVariant: $customVariant /}
  {param showTextFormat: false /}
  {param showJsonFormat: $hasSearch /}
  {param jsonFormatUrl: $jsonFormatUrl /}
{/call}
{/template}
