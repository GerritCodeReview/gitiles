      "message": "Done. Set color-scheme declarations across :root (light dark), html[data-theme\u003d\"light\"] (light), and html[data-theme\u003d\"dark\"] / @media (prefers-color-scheme: dark) (dark).",
      "parentUuid": "2250e6f7_6b4a0423",
      "revId": "61a2ed91c00c5bf0023065c88aa03ebb4882bd44",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
